# PhishGuard Pro - Environment Configuration
# Copy this file to .env and configure for your environment
# This file is shared between frontend (Next.js) and backend (FastAPI)

# =============================================================================
# SUPABASE (Shared)
# =============================================================================
# Get these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend-only (service role key for admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Backend-only (direct PostgreSQL connection for LangGraph checkpointing)
# Get from: Supabase Dashboard -> Settings -> Database -> Connection string -> URI
SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# =============================================================================
# API (Shared)
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# LLM (Backend only)
# =============================================================================
# Provider: openai | anthropic | ollama
LLM_PROVIDER=openai
# Empty = provider default (openai: gpt-6-luna / gpt-5.4-mini,
# anthropic: claude-sonnet-5-5 / claude-haiku-5-5, ollama: qwen3:8b / qwen3:4b).
# OPENAI_PRIMARY_MODEL / OPENAI_FALLBACK_MODEL are still read as fallbacks.
LLM_PRIMARY_MODEL=
LLM_FALLBACK_MODEL=
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# =============================================================================
# APPLICATION (Backend)
# =============================================================================
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# IOC ENRICHMENT (Backend only)
# =============================================================================
BITCOINABUSE_API_KEY=your-bitcoinabuse-api-key
VIRUSTOTAL_API_KEY=your-virustotal-api-key

# =============================================================================
# BASAL (Backend only, optional)
# =============================================================================
# Empty BASAL_URL disables Basal (same as BASAL_MODE=off). Modes: off | shadow | live
BASAL_URL=
BASAL_MODE=shadow
BASAL_THRESHOLD=0.9
# BASAL_THRESHOLD_PROFILER=0.95
# BASAL_THRESHOLD_IN_ROLE=0.9
# BASAL_MODE_PROFILER=shadow
# BASAL_MODE_IN_ROLE=shadow
BASAL_TIMEOUT_S=30
BASAL_MODEL=
